{% extends 'layout.twig' %}
{% import '_ui.twig' as ui %}
{% block title %}Manutenção{% endblock %}
{% block content %}
{% set sections = {
  EM_EXECUCAO: ['em-andamento', 'Em andamento', 'Intervenções iniciadas: o equipamento está "em manutenção" até a conclusão.'],
  URGENTE: ['urgentes', 'Urgentes', 'Imediatas ou com data vencida. Iniciar coloca o equipamento em manutenção.'],
  PROXIMA: ['proximas', 'Próximos 7 dias', 'Programadas para hoje até 7 dias. Agendar não tira o equipamento de operação.'],
  FUTURA: ['programadas', 'Programadas depois', 'Mais de 7 dias à frente.']
} %}
{% set resultLabels = {OPERACIONAL: 'operacional', FALHA: 'continuou com mau funcionamento', DESATIVADO: 'desativado'} %}
<div class="page">
  <div class="page-head">
    <div>
      <h1>Manutenção</h1>
      <p class="lead">Ordens abertas, da mais urgente para a mais distante. Data de hoje em Marília: {{ today|br_date }}.</p>
    </div>
  </div>

  <nav class="jump" aria-label="Ir para">
    {% for key, s in sections %}<a href="#{{ s[0] }}">{{ s[1] }} <span class="count-pill">{{ groups[key]|length }}</span></a>{% endfor %}
    <a href="#encerradas">Encerradas recentemente</a>
  </nav>

  {% for key, s in sections %}
    <section class="section" id="{{ s[0] }}" aria-labelledby="t-{{ s[0] }}">
      <div class="list-head"><h2 id="t-{{ s[0] }}">{{ s[1] }} ({{ groups[key]|length }})</h2><p class="hint">{{ s[2] }}</p></div>
      {% if groups[key] is empty %}
        <div class="empty">{{ key == 'URGENTE' ? 'Nenhuma ordem urgente agora.' : 'Nada aqui.' }}</div>
      {% else %}
      <ul class="rows">
        {% for o in groups[key] %}
          {% set type = types[o.type_code] ?? null %}
          {% set place = [o.street, o.address_ref]|filter(v => v)|join(', ') %}
          {% set busy = running[o.equipment_id] ?? null %}
          <li class="order">
            <div class="order__head">
              <span class="order__title"><a href="{{ url('/equipamentos/' ~ o.equipment_id) }}#manutencao">{{ type ? type.shortLabel : o.type_code }} · {{ place ?: (o.region_name ?? 'sem endereço cadastrado') }}</a></span>
              <span class="btn-row">
                {% if o.state == 'EM_EXECUCAO' %}{{ ui.status('EM_EXECUCAO', 'Em execução') }}
                {% else %}{{ ui.status(o.urgency.value, o.urgency.value in ['FUTURA', 'PROXIMA'] ? 'Para ' ~ o.due_date|br_date : (o.urgency.value == 'VENCIDA' ? 'Vencida em ' ~ o.due_date|br_date : 'Imediata')) }}{% endif %}
              </span>
            </div>
            <p class="order__meta"><span class="code-tag">{{ o.equipment_code }}</span> {{ o.region_name ?? 'sem bairro' }} · ordem #{{ o.id }} {{ o.kind == 'PREVENTIVA' ? 'preventiva' : 'corretiva' }} · {{ o.state == 'EM_EXECUCAO' ? 'em execução desde ' ~ o.started_at|local_dt : 'aberta em ' ~ o.opened_at|local_dt }}</p>
            <p class="order__reason"><strong>Motivo:</strong> {{ o.reason }}</p>
            {% if app.user %}
              {% if o.state == 'ABERTA' %}
                {% if busy %}
                  <p class="order__effect">Aguardando: a ordem #{{ busy }} está em execução neste equipamento (uma intervenção por vez).</p>
                {% else %}
                  <form method="post" action="{{ url('/manutencoes/' ~ o.id ~ '/iniciar') }}">{{ ui.csrf(app.csrf) }}<input type="hidden" name="voltar" value="/manutencao#{{ s[0] }}">
                    <button class="btn btn--small {{ key == 'URGENTE' ? 'btn--primary' }}" type="submit">Iniciar intervenção</button>
                    <span class="order__effect">O equipamento passa para "Em manutenção".</span>
                  </form>
                {% endif %}
              {% else %}
                <details><summary>Concluir esta intervenção</summary>
                  <form method="post" action="{{ url('/manutencoes/' ~ o.id ~ '/concluir') }}" class="complete-form">{{ ui.csrf(app.csrf) }}<input type="hidden" name="voltar" value="/manutencao#em-andamento">
                    <div class="field"><label for="res-{{ o.id }}">O que foi feito</label><textarea id="res-{{ o.id }}" name="resolution" required maxlength="500"></textarea></div>
                    <div class="field"><label for="rs-{{ o.id }}">Como o equipamento ficou?</label>
                      <span class="hint" id="rs-{{ o.id }}-h">Esta situação passa a valer para o equipamento. Informe o resultado real, mesmo que o problema continue.</span>
                      <select id="rs-{{ o.id }}" name="result_status" required aria-describedby="rs-{{ o.id }}-h"><option value="">Escolha o resultado</option><option value="OPERACIONAL">Operacional (testado e funcionando)</option><option value="FALHA">Continua com mau funcionamento</option><option value="DESATIVADO">Desativado (retirado de uso)</option></select></div>
                    <div><button class="btn btn--primary" type="submit">Concluir ordem</button></div>
                  </form>
                </details>
              {% endif %}
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
  {% endfor %}
  {% if not app.user %}<p class="callout section">Para iniciar ou concluir intervenções, <a href="{{ url('/entrar', {voltar: app.base ~ '/manutencao'}) }}">entre com a conta fornecida</a>.</p>{% endif %}

  <section class="section" id="encerradas" aria-labelledby="t-encerradas">
    <h2 id="t-encerradas">Encerradas recentemente</h2>
    {% if closed is empty %}<div class="empty">Nenhuma ordem encerrada.</div>{% else %}
    <div class="table-wrap"><table class="data">
      <thead><tr><th scope="col">Ordem</th><th scope="col">Equipamento</th><th scope="col">Resultado</th><th scope="col">Encerrada</th></tr></thead>
      <tbody>{% for o in closed %}<tr><td>#{{ o.id }} {{ o.kind == 'PREVENTIVA' ? 'preventiva' : 'corretiva' }}</td><td><a href="{{ url('/equipamentos/' ~ o.equipment_id) }}">{{ o.equipment_code }}</a></td><td>{{ o.state == 'CANCELADA' ? 'Cancelada' : 'Concluída: ' ~ (resultLabels[o.result_status] ?? o.result_status|lower) }}<br><span class="hint">{{ o.resolution }}</span></td><td>{{ o.closed_at|local_dt }}{{ o.closed_by_name ? ' · ' ~ o.closed_by_name }}</td></tr>{% endfor %}</tbody>
    </table></div>{% endif %}
  </section>
</div>
{% endblock %}
