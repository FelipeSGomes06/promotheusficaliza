{% extends 'layout.twig' %}
{% import '_ui.twig' as ui %}
{% import '_ajuda.twig' as ajuda %}
{% block title %}Retrospecto da previsão{% endblock %}
{% block content %}
<div class="page">
  <div class="page-head">
    <div>
      <p class="crumbs"><a href="{{ url('/planejar') }}">Planejar reforço</a> · retrospecto do teste</p>
      <h1>Retrospecto: a previsão congelada contra o que foi registrado</h1>
      <p class="lead">Escolha uma semana do teste de 2025, veja o que o método congelado previa com os dados disponíveis antes daquela semana e só depois revele o que foi registrado.</p>
    </div>
    <a class="btn" href="{{ url('/planejar') }}">{{ ui.icon('i-layers') }}Voltar à previsão atual</a>
  </div>

  {% if replay is null or replay.week is null %}
    <div class="empty">Nenhuma execução com retrospecto foi importada. No servidor: <code>php bin/fiscaliza urban:import</code>.</div>
  {% else %}
  {% set r = replay %}
  {% set ev = r.run.evaluation %}
  {% set test = ev.test_model %}

  <section class="era era--replay" aria-label="Dados históricos do teste">
    <p class="era__kicker">{{ ui.icon('i-clock') }} Histórico · teste de 2025 · não é a previsão atual</p>
    <dl class="era__facts">
      <div><dt>Semana</dt><dd><strong>{{ r.week|br_date }} a {{ r.week_last_day|br_date }}</strong> ({{ r.position }}ª de {{ r.weeks|length }})</dd></div>
      <div><dt>Método congelado</dt><dd>Escolhido e fixado em {{ r.run.model_issued_at|br_date }}, antes de qualquer semana do teste; não foi mudado depois</dd></div>
      <div><dt>Previsão desta semana</dt><dd>Calculada com os registros até {{ (r.sectors|first).history_through|br_date }}: os que já estariam publicados no início da semana, pela hipótese de dois meses completos de atraso</dd></div>
      <div><dt>Origem</dt><dd>{{ ui.origin_real() }}</dd></div>
    </dl>
  </section>

  <form class="section filter-bar replay-nav" method="get" action="{{ url('/planejar/retrospecto') }}">
    <div class="field">
      <label for="f-semana">Semana do teste</label>
      <select id="f-semana" name="semana">
        {% for w in r.weeks %}<option value="{{ w }}" {{ w == r.week ? 'selected' }}>{{ loop.index }}ª · {{ w|br_date }}</option>{% endfor %}
      </select>
    </div>
    <button class="btn" type="submit">Ver semana</button>
    <span class="btn-row">
      {% if r.previous %}<a class="btn btn--small" href="{{ url('/planejar/retrospecto', {semana: r.previous}) }}" rel="prev">← Semana anterior</a>{% endif %}
      {% if r.next %}<a class="btn btn--small" href="{{ url('/planejar/retrospecto', {semana: r.next}) }}" rel="next">Próxima semana →</a>{% endif %}
    </span>
  </form>

  {% set sc = r.score %}
  {% set total_weeks = r.weeks|length %}
  <section class="section placar" aria-labelledby="placar-titulo">
    <div class="list-head"><h2 id="placar-titulo">Placar da previsão até aqui</h2><p class="hint">Acerto da prioridade = o setor que o modelo mandou priorizar foi o que mais teve registros na semana.</p></div>
    <div class="score__grid">
      {% set pct = sc.rate is null ? 0 : sc.rate * 100 %}
      <div class="score__ring" role="img" aria-label="{{ sc.rate is null ? 'Sem semanas reveladas' : pct|number_format(0, ',', '.') ~ '% de acerto' }}">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <circle class="score__track" cx="60" cy="60" r="52"/>
          <circle class="score__chance" cx="60" cy="60" r="52" pathLength="100" stroke-dasharray="0.6 99.4" stroke-dashoffset="-24.7"/>
          <circle class="score__fill" cx="60" cy="60" r="52" pathLength="100" stroke-dasharray="{{ pct|round(1) }} 100"/>
        </svg>
        <div class="score__value"><strong>{{ sc.rate is null ? '—' : pct|number_format(0, ',', '.') ~ '%' }}</strong><span>de acerto</span></div>
      </div>
      <dl class="score__facts">
        <div><dt>Semanas com a prioridade certa {{ ui.help('ajuda-acerto', 'prioridade certa', ajuda.hit_rate()) }}</dt><dd><strong>{{ sc.hits }}</strong> de {{ sc.counted }}</dd></div>
        <div><dt>Se escolhesse ao acaso</dt><dd><strong>~25%</strong> (1 entre 4 setores)</dd></div>
        <div><dt>Semanas reveladas</dt><dd>{{ sc.weeks }} de {{ total_weeks }}</dd></div>
      </dl>
    </div>

    {% set W = 640 %}{% set H = 180 %}{% set px = 34 %}{% set py = 14 %}
    {% set step = total_weeks > 1 ? (W - px - 10) / (total_weeks - 1) : 0 %}
    {% set pts = [] %}
    {% for t in r.timeline %}
      {% if t.rate is not null %}{% set pts = pts|merge([(px + (loop.index0 * step))|round(1) ~ ',' ~ (py + (1 - t.rate) * (H - 2 * py))|round(1)]) %}{% endif %}
    {% endfor %}
    <figure class="score__chart">
      <svg viewBox="0 0 {{ W }} {{ H }}" role="img" aria-label="Acerto acumulado da prioridade semana a semana">
        {% for g in [0, 0.5, 1] %}
          {% set gy = py + (1 - g) * (H - 2 * py) %}
          <line class="chart__grid" x1="{{ px }}" x2="{{ W - 10 }}" y1="{{ gy }}" y2="{{ gy }}"/>
          <text class="chart__label" x="{{ px - 6 }}" y="{{ gy + 4 }}" text-anchor="end">{{ (g * 100)|round }}%</text>
        {% endfor %}
        {% set cy = py + 0.75 * (H - 2 * py) %}
        <line class="chart__chance" x1="{{ px }}" x2="{{ W - 10 }}" y1="{{ cy }}" y2="{{ cy }}"/>
        <text class="chart__label chart__label--chance" x="{{ W - 12 }}" y="{{ cy - 5 }}" text-anchor="end">acaso 25%</text>
        {% if pts|length > 1 %}<polyline class="chart__line" points="{{ pts|join(' ') }}" pathLength="100"/>{% endif %}
        {% if pts|length > 0 %}{% set lp = (pts|last)|split(',') %}<circle class="chart__dot" cx="{{ lp[0] }}" cy="{{ lp[1] }}" r="5"/>{% endif %}
      </svg>
      <figcaption class="chart__legend"><span class="lg lg--hit">acerto da prioridade (acumulado)</span><span class="lg lg--chance">acaso</span></figcaption>
    </figure>

    <ol class="week-strip" aria-label="Resultado de cada semana">
      {% for w in r.weeks %}
        {% set t = r.timeline[loop.index0] ?? null %}
        {% set cls = t is null ? 'is-hidden' : (t.hit is null ? 'is-empty' : (t.hit ? 'is-hit' : 'is-miss')) %}
        <li><a class="week-strip__dot {{ cls }}{{ w == r.week ? ' is-current' }}" href="{{ url('/planejar/retrospecto', {semana: w}) }}" title="{{ loop.index }}ª semana · {{ w|br_date }}{{ t is null ? ' · ainda não revelada' : (t.hit is null ? ' · sem registros' : (t.hit ? ' · prioridade certa' : ' · prioridade errada')) }}">{{ t is null ? '' : (t.hit is null ? '·' : (t.hit ? '✓' : '✗')) }}</a></li>
      {% endfor %}
    </ol>
  </section>

  <section class="section" aria-labelledby="semana-titulo">
    <div class="list-head"><h2 id="semana-titulo">{{ r.position }}ª semana · {{ r.week|br_date }} a {{ r.week_last_day|br_date }}</h2><p class="hint">Média simples · um setor priorizado por semana (o 1º).</p></div>
    {% set scale = 1 %}
    {% for s in r.sectors %}{% set scale = max(scale, s.value, s.observed ?? 0) %}{% endfor %}
    {% set w = r.week_result %}
    <ul class="duel {{ r.reveal ? 'is-revealed' }}">
      {% for s in r.sectors %}
        {% set best = r.reveal and w.max > 0 and s.observed == w.max %}
        <li class="duel__row{{ s.rank == 1 ? ' is-priority' }}{{ best ? ' is-best' }}">
          <div class="duel__name">
            <span class="duel__rank">{{ s.rank }}º</span> {{ s.name }}
            {% if s.rank == 1 %}<span class="tag">priorizado</span>{% endif %}
            {% if best %}<span class="tag tag--best">mais registros</span>{% endif %}
            <span class="duel__base">base: {{ s.count_52w }} registros em 52 semanas ({{ s.count_13w }} nas últimas 13)</span>
          </div>
          <div class="duel__bars">
            <div class="bar bar--expected"><svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect height="10" width="{{ (s.value / scale * 100)|round(1) }}"/></svg><b>Previsto {{ s.value|number_format(1, ',', '.') }}</b></div>
            <div class="bar bar--observed">{% if r.reveal %}<svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect height="10" width="{{ (s.observed / scale * 100)|round(1) }}"/></svg><b>Registrado {{ s.observed }}</b>{% else %}<b class="hint">Registrado: ?</b>{% endif %}</div>
          </div>
        </li>
      {% endfor %}
    </ul>

    {% if not r.reveal %}
      <form method="get" action="{{ url('/planejar/retrospecto') }}" class="section reveal-cta">
        <input type="hidden" name="semana" value="{{ r.week }}">
        <input type="hidden" name="revelar" value="1">
        <button class="btn btn--primary btn--big" type="submit">{{ ui.icon('i-check') }}Revelar o que aconteceu</button>
        <p class="hint">Aposta feita: o modelo escolheu o {{ (r.sectors|first).name|lower }}. Os registros desta semana só são enviados ao navegador depois do clique.</p>
      </form>
    {% else %}
      {% set names = {} %}{% for s in r.sectors %}{% set names = names|merge({(s.sector_id): s.name}) %}{% endfor %}
      {% set hit = w.observed > 0 and w.captured == w.max %}
      <div class="verdict section {{ w.observed == 0 ? 'verdict--empty' : (hit ? 'verdict--hit' : 'verdict--miss') }}" role="status">
        <span class="verdict__seal" aria-hidden="true">{{ w.observed == 0 ? '·' : (hit ? '✓' : '✗') }}</span>
        <div>
          <p class="verdict__title">{{ w.observed == 0 ? 'Semana sem registros' : (hit ? 'Acertou a prioridade!' : 'Errou a prioridade desta vez') }}</p>
          {% if w.observed > 0 %}<p class="verdict__why">O setor indicado para reforço ({{ names[r.first]|lower }}) {{ hit ? 'foi' : 'não foi' }} o que mais teve registros na semana.</p>{% endif %}
          <p class="m-0"><strong>{{ w.observed }} registros elegíveis</strong> na área de estudo. O {{ names[r.first]|lower }} (priorizado) teve <strong>{{ w.captured }}</strong>.</p>
          <p class="hint m-0">Uma semana isolada não prova nada: o placar acima acumula todas até aqui.</p>
        </div>
      </div>
      <p class="btn-row verdict-actions">
        {% if r.next %}<a class="btn btn--primary" href="{{ url('/planejar/retrospecto', {semana: r.next, revelar: 1}) }}">Próxima semana e revelar →</a>{% endif %}
        <a class="btn btn--small" href="{{ url('/planejar/retrospecto', {semana: r.week}) }}">Esconder os registros</a>
      </p>
    {% endif %}
  </section>

  <section class="section section--spaced" aria-labelledby="global-titulo">
    <div class="list-head"><h2 id="global-titulo">Resultado no teste inteiro</h2><p class="hint">{{ ev.baseline.weeks }} semanas completas, {{ ev.baseline.from|br_date }} a {{ ev.baseline.until|br_date }} (fim exclusivo), {{ ev.baseline.rows }} linhas setor × semana.</p></div>
    <div class="table-wrap"><table class="data">
      <thead><tr><th scope="col">Medida</th><th scope="col">Média simples {{ ui.help('ajuda-metodo', 'média simples', ajuda.method()) }}</th></tr></thead>
      <tbody>
        <tr><th scope="row">Registros no setor priorizado (1 por semana)</th><td class="num">{{ ev.baseline.top_budget_captured }} de {{ ev.baseline.observed_count }} · {{ (ev.baseline.top_budget_capture_fraction * 100)|number_format(1, ',', '.') }}%</td></tr>
        <tr><th scope="row">Erro médio por setor e semana {{ ui.help('ajuda-erro', 'erro médio', ajuda.mae()) }}</th><td class="num">{{ ev.baseline.mae|number_format(1, ',', '.') }} registro</td></tr>
        <tr><th scope="row">Total previsto × registrado</th><td class="num">{{ ev.baseline.predicted_count|number_format(0, ',', '.') }} × {{ ev.baseline.observed_count }}</td></tr>
      </tbody>
    </table></div>
    <ul class="factor-list section">
      <li>O denominador é o total de <strong>registros elegíveis na área de estudo</strong> no teste, não todos os acidentes do município; a fração não é taxa de acerto, probabilidade nem acidentes evitados.</li>
      <li>Com 4 setores, um ao acaso pegaria cerca de 25%. A previsão superestimou o total: o arquivo de 2025 tem menos registros que os anos anteriores.</li>
    </ul>
    <p class="hint section">Limitações registradas pelo treino (texto original do arquivo importado):</p>
    <ul class="factor-list">{% for l in ev.limitations %}<li>{{ l }}</li>{% endfor %}</ul>
  </section>
  {% endif %}
</div>
{% endblock %}
