{% extends 'layout.twig' %}
{% block title %}Erro {{ status }}{% endblock %}
{% block content %}
<div class="page">
  <section class="auth panel stack" aria-labelledby="erro-titulo">
    <p class="hint">Erro {{ status }}</p>
    <h1 id="erro-titulo">{{ status == 404 ? 'Página não encontrada' : (status == 401 ? 'É preciso entrar' : (status == 403 ? 'Acesso não permitido' : (status == 409 ? 'Não foi possível concluir' : 'Algo deu errado'))) }}</h1>
    <p>{{ message }}</p>
    <p class="hint">Código de referência (para quem administra): <span class="code-tag">{{ reference }}</span></p>
    <div class="btn-row">
      {% if app.user %}<a class="btn btn--primary" href="{{ url('/') }}">Ir para a visão geral</a>{% else %}<a class="btn btn--primary" href="{{ url('/entrar') }}">Entrar</a>{% endif %}
    </div>
  </section>
</div>
{% endblock %}
