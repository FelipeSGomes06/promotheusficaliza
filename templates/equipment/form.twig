{% extends 'layout.twig' %}
{% import '_ui.twig' as ui %}
{% block title %}{{ existing ? 'Editar ' ~ existing.code : 'Cadastrar equipamento' }}{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ asset('vendor/leaflet/leaflet.css') }}">{% endblock %}
{% block scripts %}<script src="{{ asset('vendor/leaflet/leaflet.js') }}" defer></script>{% endblock %}
{% block content %}
{% set v = values %}
{% set labels = {type_code: 'Tipo', status: 'Situação inicial', manufacturer: 'Marca', model: 'Modelo', serial_number: 'Série do fabricante', asset_tag: 'Patrimônio',
  agency_id: 'Órgão responsável', maint_interval_days: 'Preventiva a cada', street: 'Rua', address_ref: 'Número ou referência', cep: 'CEP', region_id: 'Bairro',
  location_kind: 'Este ponto é', lat: 'Local no mapa', lng: 'Local no mapa', installed_on: 'Data de instalação', notes: 'Observações'} %}
{% for t in types|filter(t => t.code == (v.type_code ?? '')) %}{% for f in t.fields %}{% set labels = labels|merge({('specs.' ~ f.name): f.label}) %}{% endfor %}{% endfor %}
{# column, não merge: array_merge renumera chaves numéricas e o mapa perderia os IDs #}
{% set agencyNames = agencies|column('name', 'id') %}
{% set regionNames = regions|column('name', 'id') %}
<div class="page page--narrow">
  <p class="crumbs"><a href="{{ url('/equipamentos') }}">Equipamentos</a>{% if existing %} · <a href="{{ url('/equipamentos/' ~ existing.id) }}">{{ existing.code }}</a>{% endif %}</p>
  <h1>{{ existing ? 'Editar ' ~ existing.code : 'Cadastrar equipamento' }}</h1>
  <p class="lead">Use só dados fictícios. Campos com <span class="req">*</span> são obrigatórios; a cidade é sempre Marília/SP. {{ existing ? 'Salvar registra no histórico o que mudou e quem mudou.' : 'O código interno (ex.: RAD-0012) é gerado ao salvar.' }}</p>

  {% if conflict %}
    <section class="conflict section" role="alert" aria-labelledby="conflito">
      <h2 id="conflito">O cadastro mudou enquanto você editava</h2>
      <p>{{ errors._form }} Compare abaixo o que está salvo agora com a sua versão.</p>
      {% if conflict.last %}<p class="small">Última mudança registrada: {{ conflict.last.summary }} — {{ conflict.last.actor_name ? 'por ' ~ conflict.last.actor_name ~ ', ' : '' }}{{ conflict.last.occurred_at|local_dt }}.</p>{% endif %}
      {% if conflict.changes is not empty %}
        <table>
          <thead><tr><th scope="col">Campo</th><th scope="col">Salvo agora</th><th scope="col">Sua versão</th></tr></thead>
          <tbody>
          {% for field, c in conflict.changes %}
            {% set show = field == 'agency_id' ? agencyNames : (field == 'region_id' ? regionNames : null) %}
            <tr><th scope="row">{{ labels[field] ?? (field == 'specs' ? 'Características' : field) }}</th>
              <td>{{ show ? (show[c.antes ~ ''] ?? '—') : (c.antes is iterable ? c.antes|json_encode : (c.antes ?? '—')) }}</td>
              <td>{{ show ? (show[c.depois ~ ''] ?? '—') : (c.depois is iterable ? c.depois|json_encode : (c.depois ?? '—')) }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="small">Seus dados não diferem do que está salvo agora, ou ainda têm campos a corrigir.</p>
      {% endif %}
      <p class="small">Para manter a sua versão, revise e clique em "Salvar alterações". Para ficar com a versão salva, <a href="{{ url('/equipamentos/' ~ existing.id ~ '/editar') }}">descarte suas alterações</a>.</p>
    </section>
  {% elseif errors._form is defined %}
    <div class="flash flash--error section" role="alert">{{ errors._form }}</div>
  {% endif %}
  {{ ui.error_summary(errors, labels, 's-' ~ (v.type_code ?? '') ~ '-') }}

  <form method="post" action="{{ existing ? url('/equipamentos/' ~ existing.id) : url('/equipamentos') }}" class="stack section" novalidate{% if existing %} data-equipment-status="{{ existing.status }}"{% endif %}>
    {{ ui.csrf(app.csrf) }}
    {% if existing %}<input type="hidden" name="version" value="{{ v.version ?? existing.version_no }}">{% endif %}

    <fieldset class="form-step">
      <legend><span class="form-step__n" aria-hidden="true">1</span> O que é</legend>
      <div class="form-grid">
        <div class="field {{ errors.type_code is defined ? 'has-error' }}">
          <label for="f-type_code">Tipo <span class="req" aria-hidden="true">*</span></label>
          <select id="f-type_code" name="type_code" data-type-select required {% if errors.type_code is defined %}aria-invalid="true" aria-describedby="err-type_code"{% endif %}>
            {% for t in types %}<option value="{{ t.code }}" data-mobile="{{ t.mobile ? '1' : '0' }}" {{ (v.type_code ?? '') == t.code ? 'selected' }}>{{ t.label }}</option>{% endfor %}
          </select>
          {{ ui.field_error(errors, 'type_code') }}
        </div>
        {% if not existing %}
          {{ ui.select('status', 'Situação inicial', {NAO_INSTALADO: 'Não instalado (ainda vai ser instalado ou entrar em operação)', OPERACIONAL: 'Operacional', FALHA: 'Mau funcionamento', MANUTENCAO: 'Em manutenção', DESATIVADO: 'Desativado', FURTADO: 'Furtado'}, v.status ?? 'NAO_INSTALADO', errors, {required: true}) }}
        {% else %}
          <div class="field"><span class="label">Situação</span><span>{{ ui.equipment_status(existing.status) }}</span><span class="hint">Mude a situação pela ficha: fica no histórico com o motivo.</span></div>
        {% endif %}
        {{ ui.input('manufacturer', 'Marca', v, errors, {required: true, max: 80}) }}
        {{ ui.input('model', 'Modelo', v, errors, {required: true, max: 80}) }}
        <div class="field {{ errors.agency_id is defined ? 'has-error' }}">
          <label for="f-agency_id">Órgão responsável <span class="req" aria-hidden="true">*</span></label>
          <select id="f-agency_id" name="agency_id" required {% if errors.agency_id is defined %}aria-invalid="true" aria-describedby="err-agency_id"{% endif %}><option value="">Escolha…</option>{% for a in agencies %}<option value="{{ a.id }}" {{ ((v.agency_id ?? '') ~ '') == (a.id ~ '') ? 'selected' }}>{{ a.name }}</option>{% endfor %}</select>
          {{ ui.field_error(errors, 'agency_id') }}
        </div>
        {{ ui.input('serial_number', 'Série do fabricante', v, errors, {max: 60, help: 'Única por marca. Deixe em branco se não souber.'}) }}
        {{ ui.input('asset_tag', 'Patrimônio', v, errors, {max: 30, help: 'Número da plaqueta, se houver. Único.'}) }}
      </div>
    </fieldset>

    <fieldset class="form-step">
      <legend><span class="form-step__n" aria-hidden="true">2</span> Onde fica</legend>
      <p class="hint">Todo equipamento tem um local, mesmo o planejado: é onde ele está ou vai ficar, para a utilidade que se planejou.</p>
      <div class="form-grid">
        {{ ui.select('location_kind', 'Este ponto é', {INSTALADO: 'Local de instalação (já instalado)', PLANEJADO: 'Local planejado (ainda não instalado)', BASE: 'Base: onde o veículo ou patinete fica guardado'}, v.location_kind ?? 'PLANEJADO', errors, {required: true, dataAttr: 'location-kind', class: 'span-2'}) }}
        <p class="hint span-2">A situação define o ponto: "Não instalado" usa local planejado; operacional, mau funcionamento, em manutenção e furtado usam o local de instalação; desativado aceita os dois.</p>
        <p class="hint span-2" data-mobile-note hidden>Veículos e patinetes usam a base como endereço; a posição atual vem das observações recebidas e é mostrada à parte.</p>
      </div>
      <p class="hint" data-without-map="picker">Sem o mapa (JavaScript desligado ou mapa que não carregou): preencha o endereço abaixo e, ao salvar, o local vai para ele.</p>
      <p class="picker-howto" id="picker-howto" hidden data-needs-map="picker">{{ ui.icon('i-pin') }}<span><strong>Clique no mapa para marcar ou mudar o local.</strong> Não achou o lugar? Use o endereço logo abaixo.</span></p>
      <div class="picker" id="picker" hidden data-picker data-lat="f-lat" data-lng="f-lng" data-status="picker-status" data-empty="Clique no mapa para marcar o local." data-marked="Local marcado em {ponto}. Para mudar, clique em outro ponto." data-mark-center data-tiles="{{ app.map.tiles }}" data-attribution="{{ app.map.attribution }}" role="application" aria-label="Mapa para marcar o local: clique para marcar ou mudar o ponto. Pelo teclado, mova o mapa com as setas e tecle Enter para marcar o centro." aria-describedby="picker-howto"></div>
      <p class="picker-status" id="picker-status" aria-live="polite" hidden data-needs-map="picker"></p>
      {# Latitude e longitude não são digitadas: vêm do mapa (picker.js) ou do endereço (cep.js / servidor ao salvar). #}
      <input type="hidden" id="f-lat" name="lat" value="{{ v.lat ?? '' }}">
      <input type="hidden" id="f-lng" name="lng" value="{{ v.lng ?? '' }}">
      {% set pointError = errors.lat ?? errors.lng ?? null %}
      {% if pointError %}<p class="error base-point-error" id="err-lat" role="alert">{{ pointError }}</p>{% endif %}
      <p class="hint base-region">Bairro: {% if existing and existing.region_name %}<strong>{{ existing.region_name }}</strong> (muda sozinho se você mudar o ponto){% else %}definido pelo ponto, ao salvar{% endif %}.</p>
      <p class="hint base-address__intro">Endereço: com o CEP, a rua é preenchida sozinha e pode ser corrigida. Se não marcar no mapa, o local vai para este endereço.</p>
      <div class="form-grid base-address" data-cep-lookup data-cep="f-cep" data-street="f-street" data-number="f-address_ref"
           data-url="{{ url('/api/cep/') }}" data-locate-url="{{ url('/api/localizar') }}" data-lat="f-lat" data-lng="f-lng" data-map="picker">
        {{ ui.input('cep', 'CEP', v, errors, {max: 9, inputmode: 'numeric', placeholder: '17500-000', autocomplete: 'off'}) }}
        {# Sistema de Marília: a cidade é fixa, mostrada como campo travado (não é enviada). #}
        <div class="field"><label for="f-city">Cidade</label><input id="f-city" type="text" value="Marília / SP" readonly class="input-fixed"></div>
        {{ ui.input('street', 'Rua', v, errors, {max: 120, placeholder: 'Ex.: Avenida Sampaio Vidal'}) }}
        {{ ui.input('address_ref', 'Número ou referência', v, errors, {max: 160, placeholder: 'Ex.: 1200, km 3 ou em frente à praça'}) }}
        <p class="cep-street__status span-2" data-cep-status aria-live="polite"></p>
        <div class="cep-street__locate span-2" data-locate-box hidden>
          <button type="button" class="btn btn--small" data-locate>{{ ui.icon('i-pin') }}Levar o local até este endereço</button>
          <p class="cep-street__locate-status" data-locate-status aria-live="polite"></p>
        </div>
      </div>
    </fieldset>

    <fieldset class="form-step">
      <legend><span class="form-step__n" aria-hidden="true">3</span> Características</legend>
      {% for t in types %}
        <fieldset class="spec-fieldset" data-spec-type="{{ t.code }}" {{ (v.type_code ?? '') != t.code ? 'hidden disabled' }}>
          <legend class="visually-hidden">Características de {{ t.label }}</legend>
          <p class="hint">{{ t.description }}</p>
          <div class="form-grid">
          {% for f in t.fields %}
            {% set key = 'specs.' ~ f.name %}
            {% set current = v.specs[f.name] ?? null %}
            <div class="field {{ errors[key] is defined ? 'has-error' }}">
              {% if f.kind == 'bool' %}
                <span class="label">{{ f.label }}</span>
                <div class="checks"><label><input id="s-{{ t.code }}-{{ f.name }}" type="checkbox" name="specs[{{ f.name }}]" value="1" {{ current ? 'checked' }}> Sim</label></div>
              {% elseif f.kind == 'multi' %}
                <span class="label" id="s-{{ t.code }}-{{ f.name }}">{{ f.label }}{% if f.required ?? false %} <span class="req" aria-hidden="true">*</span>{% endif %}</span>
                <div class="checks" role="group" aria-labelledby="s-{{ t.code }}-{{ f.name }}">{% for ov, ol in f.options %}<label><input type="checkbox" name="specs[{{ f.name }}][]" value="{{ ov }}" {{ ov in (current ?? []) ? 'checked' }}> {{ ol }}</label>{% endfor %}</div>
              {% elseif f.kind == 'enum' %}
                <label for="s-{{ t.code }}-{{ f.name }}">{{ f.label }}{% if f.required ?? false %} <span class="req" aria-hidden="true">*</span>{% endif %}</label>
                <select id="s-{{ t.code }}-{{ f.name }}" name="specs[{{ f.name }}]"><option value="">—</option>{% for ov, ol in f.options %}<option value="{{ ov }}" {{ current == ov ? 'selected' }}>{{ ol }}</option>{% endfor %}</select>
              {% else %}
                <label for="s-{{ t.code }}-{{ f.name }}">{{ f.label }}{% if f.unit is defined %} ({{ f.unit }}){% endif %}{% if f.required ?? false %} <span class="req" aria-hidden="true">*</span>{% endif %}</label>
                <input id="s-{{ t.code }}-{{ f.name }}" name="specs[{{ f.name }}]" type="{{ f.kind == 'int' ? 'number' : 'text' }}" value="{{ current }}" {% if f.kind == 'int' %}min="{{ f.min }}" max="{{ f.max }}"{% else %}maxlength="{{ f.max ?? 120 }}"{% endif %}>
              {% endif %}
              {% if f.help is defined %}<span class="hint">{{ f.help }}</span>{% endif %}
              {{ ui.field_error(errors, key) }}
            </div>
          {% endfor %}
          </div>
        </fieldset>
      {% endfor %}
      <div class="form-grid section">
        {{ ui.input('maint_interval_days', 'Preventiva a cada (dias)', v, errors, {type: 'number', help: 'De 7 a 730. Ao concluir uma preventiva, a próxima é agendada sozinha.'}) }}
        {{ ui.input('installed_on', 'Data de instalação', v, errors, {type: 'date', help: 'Veículo e patinete: data em que entrou em operação.'}) }}
        {{ ui.input('notes', 'Observações', v, errors, {type: 'textarea', max: 500, class: 'span-2'}) }}
      </div>
    </fieldset>

    <div class="form-actions">
      <a class="btn btn--quiet" href="{{ existing ? url('/equipamentos/' ~ existing.id) : url('/equipamentos') }}">Cancelar</a>
      <button class="btn btn--primary" type="submit">{{ existing ? 'Salvar alterações' : 'Cadastrar equipamento' }}</button>
    </div>
  </form>
</div>
{% endblock %}
