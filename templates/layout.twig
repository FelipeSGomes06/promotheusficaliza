{% import '_ui.twig' as ui %}
{% set links = not app.user ? [] : [['/', 'Visão geral', 'i-overview'], ['/equipamentos', 'Equipamentos', 'i-equipment'], ['/agentes', 'Agentes', 'i-agents'], ['/manutencao', 'Manutenção', 'i-wrench'], ['/antecipacao', 'Revisões recomendadas', 'i-chart'], ['/sobre', 'Sobre', 'i-info']] %}
{% if app.user and app.user.role == 'ADMIN' %}{% set links = links|merge([['/contas', 'Contas', 'i-users']]) %}{% endif %}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% block title %}Visão geral{% endblock %} · Promotheus Fiscaliza</title>
  <meta name="description" content="Central de recursos de fiscalização de trânsito de Marília/SP — demonstração com dados fictícios (DSIN Coder Challenge 2026, etapa F.O.G.O.).">
  <meta name="theme-color" content="#0f1a2b">
  <link rel="icon" href="{{ asset('img/favicon.svg') }}" type="image/svg+xml">
  {{ vite_styles() }}
  {% block head %}{% endblock %}
  {% block scripts %}{% endblock %}
  {{ vite_script() }}
</head>
<body data-page="{% block page %}{% endblock %}" data-icons="{{ asset('img/icons.svg') }}">
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <div class="shell">
    <aside class="rail" id="menu-principal" aria-label="Menu" x-data="nav" @keydown.escape="closeFromKey" @pf-nav-toggle.window="toggle">
      <a class="rail__brand" href="{{ url('/') }}">
        <svg class="brand-mark" aria-hidden="true" focusable="false"><use href="{{ asset('img/icons.svg') }}#i-brand"></use></svg>
        <span class="brand-word"><span class="brand-word__a">Promotheus</span><span class="brand-word__b">Fiscaliza</span><span class="brand-word__city">Marília · SP</span></span>
      </a>
      {% if app.user %}
      <nav aria-label="Principal">
        <ul class="rail__nav">
          {% for link in links %}
            {% set active = link[0] == '/' ? app.path == '/' : app.path starts with link[0] %}
            <li><a class="rail__link" href="{{ url(link[0]) }}" {% if active %}aria-current="page"{% endif %}>{{ ui.icon(link[2]) }}<span>{{ link[1] }}</span></a></li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
      <div class="rail__foot">
        {% if app.user %}
          <div class="rail__account"><span class="avatar">{{ ui.icon('i-user') }}</span><span><strong>{{ app.user.display_name }}</strong><span>{{ app.user.role == 'ADMIN' ? 'Administrador' : 'Operador' }}</span></span></div>
          <form class="inline-form" method="post" action="{{ url('/sair') }}">{{ ui.csrf(app.csrf) }}<button class="btn btn--small btn--dark" type="submit">{{ ui.icon('i-logout') }}<span>Sair</span></button></form>
        {% elseif app.path != '/entrar' %}
          {# Sem conta não há menu: todo o sistema exige login com conta cadastrada pelo administrador. #}
          <a class="btn btn--small btn--primary" href="{{ url('/entrar') }}">{{ ui.icon('i-user') }}<span>Entrar</span></a>
        {% endif %}
        <button type="button" class="motion-pref" x-data="motionPref" @click="toggle" :aria-pressed="pressed" aria-describedby="motion-why">
          {{ ui.icon('i-motion') }}
          <span><span class="motion-pref__state" x-text="stateLabel">Animações</span><span class="motion-pref__why" id="motion-why" x-text="whyLabel">Segue a preferência do sistema</span></span>
        </button>
        <p class="m-0">Dados fictícios · mapa <a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap</a>{% if app.user %} · <a href="{{ url('/sobre') }}">o que é real</a>{% endif %}</p>
      </div>
    </aside>
    <div class="rail-scrim" data-rail-scrim hidden></div>

    <div class="main" {% block main_attrs %}{% endblock %}>
      <header class="topbar">
        <button class="btn btn--small btn--ghost btn--icon menu-btn" type="button" aria-controls="menu-principal" aria-expanded="false" aria-label="Abrir menu" data-menu-btn>{{ ui.icon('i-menu') }}</button>
        <a class="topbar__brand" href="{{ url('/') }}">
          <svg class="brand-mark" aria-hidden="true" focusable="false"><use href="{{ asset('img/icons.svg') }}#i-brand"></use></svg>
          <span class="brand-word"><span class="brand-word__a">Promotheus</span><span class="brand-word__b">Fiscaliza</span></span>
        </a>
        {% block topbar %}
          {% set current = links|filter(l => (l[0] == '/' ? app.path == '/' : app.path starts with l[0]))|first %}
          <div class="topbar__title">{% if current %}{{ ui.icon(current[2]) }}<span>{{ current[1] }}</span>{% else %}{{ ui.icon('i-user') }}<span>{{ block('title') }}</span>{% endif %}</div>
        {% endblock %}
        <div class="topbar__end">
          {% block topbar_end %}{% endblock %}
          <details class="demo-badge" data-popover>
            <summary>Demonstração</summary>
            <div class="popover" role="note">
              <p><strong>Tudo aqui é fictício.</strong> Dados, órgãos, marcas, modelos e agentes são inventados; os pontos em Marília/SP são ilustrativos.</p>
              <p>Não há integração com prefeitura, polícia ou equipamentos reais.{% if app.user %} <a href="{{ url('/sobre') }}">O que é real, simulado e implementado</a>{% endif %}</p>
            </div>
          </details>
        </div>
      </header>
      <main id="conteudo" tabindex="-1">
        {% block flash %}
          {% if app.flash %}
            <div class="flash-stack" data-flash-stack>
              {% for f in app.flash %}<div class="flash flash--{{ f.type }}" role="{{ f.type == 'error' ? 'alert' : 'status' }}" data-flash data-type="{{ f.type }}">{{ f.message }}</div>{% endfor %}
            </div>
          {% endif %}
        {% endblock %}
        {% block content %}{% endblock %}
      </main>
    </div>
  </div>
  <div class="toasts" data-toasts></div>
  <div class="visually-hidden" aria-live="polite" data-live-polite></div>
  <div class="visually-hidden" aria-live="assertive" data-live-assertive></div>
</body>
</html>
