{% extends 'layout.twig' %}
{% import '_ui.twig' as ui %}
{% import '_ajuda.twig' as ajuda %}
{% set registered = existing and existing.record_state == 'REGISTRADO' %}
{% set heading = existing ? (registered ? 'Retificar ' : 'Completar ') ~ existing.code : 'Cadastrar multa' %}
{% block title %}{{ heading }}{% endblock %}
{% block page %}multas-form{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ asset('vendor/leaflet/leaflet.css') }}">{% endblock %}
{% block scripts %}<script src="{{ asset('vendor/leaflet/leaflet.js') }}" defer></script>{% endblock %}
{% block content %}
{% set v = values %}
{% set source = v.source_kind ?? '' %}
{# column, e não merge: merge renumera chaves numéricas e as opções deixariam de carregar o ID do órgão. #}
{% set agencyNames = agencies|column('name', 'id') %}
<div class="page page--narrow">
  <p class="crumbs"><a href="{{ url('/multas') }}">Multas</a>{% if existing %} · <a href="{{ url('/multas/' ~ existing.id) }}">{{ existing.code }}</a>{% endif %}</p>
  <h1>{{ heading }}</h1>
  <div class="lead">Use só dados fictícios. {{ registered ? 'O registro já foi conferido: mudar os dados cria uma retificação com motivo, e o original continua no histórico.' : 'Rascunho aceita campos em branco; o que for preenchido precisa estar bem formado. Os campos com * são exigidos para registrar.' }} {{ ui.help('ajuda-registro', 'rascunho, registro e retificação', ajuda.fine_record()) }}</div>

  {% if changes is not null %}
    <section class="conflict section" role="alert" aria-labelledby="conflito">
      <h2 id="conflito">O registro mudou enquanto você editava</h2>
      <p>{{ errors._form }} Compare o que está salvo agora com a sua versão.</p>
      {% if changes is not empty %}
        <div class="table-wrap"><table>
          <thead><tr><th scope="col">Campo</th><th scope="col">Salvo agora</th><th scope="col">Sua versão</th></tr></thead>
          <tbody>{% for field, c in changes %}<tr><th scope="row">{{ labels[field] ?? field }}</th>
            <td>{{ field == 'agency_id' ? (agencyNames[c.antes ~ ''] ?? '—') : (c.antes is iterable ? c.antes|json_encode : (c.antes ?? '—')) }}</td>
            <td>{{ field == 'agency_id' ? (agencyNames[c.depois ~ ''] ?? '—') : (c.depois is iterable ? c.depois|json_encode : (c.depois ?? '—')) }}</td></tr>{% endfor %}</tbody>
        </table></div>
      {% else %}<p class="small">Seus dados não diferem do que está salvo agora, ou ainda têm campos a corrigir.</p>{% endif %}
      <p class="small">Para manter a sua versão, revise e salve de novo. Para ficar com a salva, <a href="{{ url('/multas/' ~ existing.id ~ '/editar') }}">descarte suas alterações</a>.</p>
    </section>
  {% elseif errors._form is defined %}
    <div class="flash flash--error section" role="alert">{{ errors._form }}</div>
  {% endif %}
  {{ ui.error_summary(errors, labels) }}

  <form method="post" action="{{ existing ? url('/multas/' ~ existing.id) : url('/multas') }}" class="stack section" novalidate data-fine-form>
    {{ ui.csrf(app.csrf) }}
    <input type="hidden" name="command_uid" value="{{ v.command_uid ?? '' }}">
    {% if existing %}<input type="hidden" name="version" value="{{ v.version ?? existing.version_no }}">{% endif %}

    <fieldset class="form-step">
      <legend><span class="form-step__n" aria-hidden="true">1</span> Ocorrência</legend>
      <div class="form-grid">
        {{ ui.select('infraction_kind', 'Tipo de infração', kinds, v.infraction_kind ?? '', errors, {empty: 'A definir', required: true, dataAttr: 'fine-kind', help_tip: ajuda.infraction_kind()}) }}
        {# Fatos já anotados na situação da multa (FineService::FACT_DATES): a ocorrência não pode ficar depois deles. #}
        {% set facts = existing ? [existing.autuation_issued_on, existing.autuation_received_on, existing.penalty_issued_on, existing.penalty_received_on, existing.paid_on, existing.contest_submitted_on, existing.contest_decided_on, existing.closed_on]|filter(d => d) : [] %}
        {{ ui.input('occurred_at', 'Data e hora da ocorrência', v, errors, {type: 'datetime-local', required: true, help_tip: ajuda.occurred_at(facts is empty ? null : min(facts))}) }}
        {% if facts is not empty and errors.occurred_at is defined %}
          <p class="hint span-2"><a href="{{ url('/multas/' ~ existing.id) }}#andamento" target="_blank" rel="noopener">Abrir a situação da multa em outra aba</a>: esta página continua com o que você digitou.</p>
        {% endif %}
        {{ ui.input('legal_reference', 'Enquadramento informado', v, errors, {required: true, max: 120, help_tip: ajuda.legal_reference()}) }}
        {{ ui.select('agency_id', 'Órgão autuador', agencyNames, v.agency_id ?? '', errors, {empty: 'Escolha…', required: true, help_tip: ajuda.fine_agency()}) }}
        {# Opcionais e só transcritos: recolhidos, abertos quando já têm valor ou erro. #}
        <details class="advanced span-2" {{ (v.infraction_code ?? '') or (v.infraction_detail ?? '') or errors.infraction_code is defined or errors.infraction_detail is defined ? 'open' }}>
          <summary>Código da infração no documento (opcional)</summary>
          <div class="form-grid">
            {{ ui.input('infraction_code', 'Código', v, errors, {max: 20}) }}
            {{ ui.input('infraction_detail', 'Desdobramento', v, errors, {max: 10}) }}
          </div>
        </details>
        {{ ui.input('external_ait', 'Número do AIT (externo)', v, errors, {max: 40, class: 'span-2', help_tip: ajuda.ait()}) }}
        {# Alternativa ao AIT para registrar (FineRules::missingForRegistration); com JavaScript some quando o AIT é digitado. #}
        <details class="advanced span-2" data-show-if="external_ait=" {{ (v.ait_missing_reason ?? '') or errors.external_ait is defined or errors.ait_missing_reason is defined ? 'open' }}>
          <summary>Não tem o número do AIT?</summary>
          {{ ui.input('ait_missing_reason', 'Por que o AIT não está disponível', v, errors, {max: 160, help_tip: ajuda.missing_reason('número de AIT', ['auto ainda não recebido'])}) }}
        </details>
      </div>
      <h3 class="form-sub">Onde</h3>
      <p class="hint">Endereço ou referência bastam. O ponto no mapa é opcional e ilustrativo.</p>
      <div class="form-grid">
        {{ ui.input('street', 'Logradouro', v, errors, {max: 120, placeholder: 'Ex.: Avenida Sampaio Vidal', class: 'span-2', help_tip: ajuda.street()}) }}
        {{ ui.input('address_ref', 'Número ou referência', v, errors, {max: 160, placeholder: 'Ex.: 1200, S/N, km 3 ou em frente à praça', help_tip: ajuda.address_ref()}) }}
        {{ ui.select('region_id', 'Bairro', regions|column('name', 'id'), v.region_id ?? '', errors, {empty: 'Sem bairro'}) }}
      </div>
      <div class="picker" id="picker" data-picker data-lat="f-lat" data-lng="f-lng" data-status="picker-status" data-tiles="{{ app.map.tiles }}" data-attribution="{{ app.map.attribution }}" role="application" aria-label="Mapa opcional para marcar o local. Os campos de coordenadas em Opções avançadas fazem o mesmo."></div>
      <p class="picker-status" id="picker-status" aria-live="polite"></p>
      <p><button type="button" class="btn btn--quiet btn--small" data-clear-point="picker">Remover ponto marcado</button></p>
      <details class="advanced" {{ errors.lat is defined or errors.lng is defined ? 'open' }}>
        <summary>Opções avançadas: coordenadas</summary>
        <div class="form-grid">
          {{ ui.input('lat', 'Latitude', v, errors, {max: 20, inputmode: 'decimal', placeholder: '-22.213900'}) }}
          {{ ui.input('lng', 'Longitude', v, errors, {max: 20, inputmode: 'decimal', placeholder: '-49.945800'}) }}
        </div>
      </details>
      <div class="form-grid">
        {# Depois do tipo e do local: com JavaScript vem sugerida a partir deles (multas.js) e continua editável. #}
        {{ ui.input('description', 'Descrição curta', v, errors, {required: true, max: 240, class: 'span-2', help_tip: ajuda.fine_description()}) }}
        {{ ui.input('notes', 'Relato factual', v, errors, {type: 'textarea', max: 1000, class: 'span-2', help_tip: ajuda.fine_notes()}) }}
      </div>
    </fieldset>

    <fieldset class="form-step">
      <legend><span class="form-step__n" aria-hidden="true">2</span> Como foi constatada</legend>
      <div class="field {{ errors.source_kind is defined ? 'has-error' }}">
        <div class="field__head"><span class="label" id="lbl-source">Origem principal <span class="req" aria-hidden="true">*</span></span>{{ ui.help('f-source_kind-tip', 'Origem principal', ajuda.fine_source()) }}</div>
        <div class="checks checks--inline" role="radiogroup" aria-labelledby="lbl-source" aria-describedby="{{ errors.source_kind is defined ? 'err-source_kind ' }}f-source_kind-tip">
          <label><input type="radio" id="f-source_kind" name="source_kind" value="RADAR" data-fine-source {{ source == 'RADAR' ? 'checked' }}> Radar</label>
          <label><input type="radio" name="source_kind" value="AGENTE" data-fine-source {{ source == 'AGENTE' ? 'checked' }}> Agente de trânsito</label>
          <label><input type="radio" name="source_kind" value="" data-fine-source {{ source == '' ? 'checked' }}> Ainda não sei</label>
        </div>
        {{ ui.field_error(errors, 'source_kind') }}
      </div>
      <p class="hint" data-fine-nojs>Preencha só o bloco da origem escolhida; o outro é ignorado ao salvar (um radar indicado com origem Agente é recusado).</p>

      <fieldset class="source-block" data-source-block="RADAR">
        <legend>Radar</legend>
        <div class="form-grid">
          <div class="field span-2 {{ errors.equipment_id is defined ? 'has-error' }}">
            <div class="field__head"><label for="f-equipment_id">Radar do inventário <span class="req" aria-hidden="true">*</span></label>{{ ui.help('f-equipment_id-tip', 'Radar do inventário', ajuda.fine_radar()) }}</div>
            <div class="field__body">
            <select id="f-equipment_id" name="equipment_id" aria-describedby="{{ errors.equipment_id is defined ? 'err-equipment_id ' }}f-equipment_id-tip"><option value="">Escolha…</option>
              {% for r in sources.radars %}<option value="{{ r.id }}" data-agency="{{ r.agency_id }}" data-functions="{{ r.functions|join(' ') }}" data-modality="{{ r.modality }}" data-never-installed="{{ r.status == 'NAO_INSTALADO' and not r.installed_on ? '1' : '0' }}" {{ ((v.equipment_id ?? '') ~ '') == (r.id ~ '') ? 'selected' }}>{{ r.code }} · {{ r.manufacturer }} {{ r.model }}{{ r.street ? ' · ' ~ r.street }} · {{ r.agency_code }}{{ r.speed_limit_kmh ? ' · limite cadastrado ' ~ r.speed_limit_kmh ~ ' km/h' }}{{ r.modality == 'PORTATIL' ? ' · portátil' : (r.modality == 'FIXO' ? ' · fixo') }}{{ r.status == 'NAO_INSTALADO' ? ' (não instalado)' }}{{ r.archived_at ? ' (arquivado)' }}</option>{% endfor %}
            </select>
            {{ ui.field_error(errors, 'equipment_id') }}
            </div>
          </div>
        </div>
        <details class="advanced" {{ (v.operator_agent_id ?? '') or errors.operator_agent_id is defined ? 'open' }}>
          <summary>Medidor portátil operado por um agente? (opcional)</summary>
          <div class="field {{ errors.operator_agent_id is defined ? 'has-error' }}">
            <div class="field__head"><label for="f-operator_agent_id">Agente operador associado <span class="optional">(opcional)</span></label>{{ ui.help('f-operator_agent_id-tip', 'Agente operador associado', ajuda.fine_operator()) }}</div>
            <select id="f-operator_agent_id" name="operator_agent_id" aria-describedby="{{ errors.operator_agent_id is defined ? 'err-operator_agent_id ' }}f-operator_agent_id-tip"><option value="">Nenhum</option>
              {% for g in sources.agents %}<option value="{{ g.id }}" {{ ((v.operator_agent_id ?? '') ~ '') == (g.id ~ '') ? 'selected' }}>{{ g.code }} · {{ g.call_sign }} · {{ g.agency_code }}{{ g.archived_at ? ' (arquivado)' }}</option>{% endfor %}
            </select>
            {{ ui.field_error(errors, 'operator_agent_id') }}
          </div>
        </details>
        <div class="speed-block" data-speed-block>
          <div class="field__head"><h3 class="form-sub">Velocidades (só para excesso de velocidade)</h3>{{ ui.help('ajuda-velocidades', 'velocidades', ajuda.speeds()) }}</div>
          <div class="form-grid form-grid--three">
            {{ ui.input('speed_limit_kmh', 'Regulamentada', v, errors, {type: 'number', inputmode: 'numeric', required: true}) }}
            {{ ui.input('speed_measured_kmh', 'Medida', v, errors, {type: 'number', inputmode: 'numeric', required: true}) }}
            <div class="field"><div class="field__head"><span class="label">Considerada</span></div><div class="field__body"><output class="speed-calc" data-speed-considered for="f-speed_measured_kmh">{{ v.speed_considered_kmh ?? '' ? v.speed_considered_kmh ~ ' km/h' : 'calculada ao salvar' }}</output><span class="hint">Medida − margem de erro</span></div></div>
          </div>
        </div>
        <details class="advanced" {{ v.radar_inmetro_record ?? v.radar_certificate ?? v.radar_verified_on ?? v.evidence_reference ?? false ? 'open' }}>
          <summary>Dados do medidor e evidência</summary>
          <p class="hint">Copie do documento quando disponíveis. Em excesso de velocidade, ausentes, o registro aparece como "A conferir"; nas outras infrações não são cobrados. Nada é estimado.</p>
          <div class="form-grid">
            {{ ui.input('radar_meter_kind', 'Tipo de medidor informado', v, errors, {max: 120}) }}
            {{ ui.input('radar_inmetro_record', 'Registro no Inmetro', v, errors, {max: 120}) }}
            {{ ui.input('radar_certificate', 'Certificado de verificação', v, errors, {max: 120}) }}
            {{ ui.input('radar_verified_on', 'Última verificação metrológica', v, errors, {type: 'date'}) }}
            {{ ui.input('evidence_reference', 'Referência da evidência', v, errors, {max: 240, class: 'span-2', help_tip: ajuda.evidence_reference()}) }}
          </div>
        </details>
      </fieldset>

      <fieldset class="source-block" data-source-block="AGENTE">
        <legend>Agente de trânsito</legend>
        <div class="field {{ errors.agent_id is defined ? 'has-error' }}">
          <div class="field__head"><label for="f-agent_id">Agente da constatação <span class="req" aria-hidden="true">*</span></label>{{ ui.help('f-agent_id-tip', 'Agente da constatação', ajuda.fine_agent()) }}</div>
          <select id="f-agent_id" name="agent_id" aria-describedby="{{ errors.agent_id is defined ? 'err-agent_id ' }}f-agent_id-tip"><option value="">Escolha…</option>
            {% for g in sources.agents %}<option value="{{ g.id }}" data-agency="{{ g.agency_id }}" {{ ((v.agent_id ?? '') ~ '') == (g.id ~ '') ? 'selected' }}>{{ g.code }} · {{ g.call_sign }} · {{ g.agency_code }}{{ g.archived_at ? ' (arquivado)' }}</option>{% endfor %}
          </select>
          {{ ui.field_error(errors, 'agent_id') }}
        </div>
      </fieldset>
      {# Exigida só quando os órgãos diferem (FineService::divergence); com JavaScript aparece nesse caso (multas.js). #}
      <div data-source-note>{{ ui.input('source_note', 'Observação sobre a origem', v, errors, {type: 'textarea', max: 300, help_tip: ajuda.source_note()}) }}</div>
    </fieldset>

    <fieldset class="form-step">
      <legend><span class="form-step__n" aria-hidden="true">3</span> Veículo autuado</legend>
      {# A antiga etapa "Documentação na ocorrência" era só texto: o que importa para quem preenche ficou aqui. #}
      <p class="hint">É o veículo da ocorrência, não uma viatura do inventário. Use placas e números fictícios. Os documentos do carro são conferidos na ficha, depois de salvar{% if existing %} (hoje: <strong>{{ doc_labels[existing.occ_doc_status] }}</strong>); mudar placa, UF, RENAVAM, marca, modelo, espécie ou a data/hora da ocorrência pede uma nova conferência{% endif %}.</p>
      <div class="form-grid">
        {{ ui.input('vehicle_plate', 'Placa', v, errors, {required: true, max: 10, autocomplete: 'off', placeholder: 'AAA1A23', help_tip: ajuda.plate()}) }}
        {{ ui.select('vehicle_uf', 'UF de registro', ufs|reduce((carry, u) => carry|merge({(u): u}), {}), v.vehicle_uf ?? '', errors, {empty: 'Escolha…', required: true}) }}
        {{ ui.input('vehicle_manufacturer', 'Marca', v, errors, {required: true, max: 80}) }}
        {{ ui.input('vehicle_model', 'Modelo', v, errors, {required: true, max: 80}) }}
        {{ ui.input('vehicle_species', 'Espécie', v, errors, {required: true, max: 40, placeholder: 'Ex.: passageiro', help_tip: ajuda.vehicle_species()}) }}
        {{ ui.input('vehicle_renavam', 'RENAVAM', v, errors, {max: 11, inputmode: 'numeric', autocomplete: 'off', help_tip: ajuda.renavam()}) }}
        {# Alternativa ao RENAVAM para registrar, como a do AIT. #}
        <details class="advanced span-2" data-show-if="vehicle_renavam=" {{ (v.renavam_missing_reason ?? '') or errors.vehicle_renavam is defined or errors.renavam_missing_reason is defined ? 'open' }}>
          <summary>Não tem o RENAVAM?</summary>
          {{ ui.input('renavam_missing_reason', 'Por que o RENAVAM não está disponível', v, errors, {max: 160, help_tip: ajuda.missing_reason('RENAVAM', ['documento do carro não apresentado'])}) }}
        </details>
        {# Opcionais: na linha inteira, para Cor e Ano ficarem lado a lado sem apertar a coluna. #}
        <details class="advanced span-2" {{ (v.vehicle_color ?? '') or (v.vehicle_year ?? '') or errors.vehicle_color is defined or errors.vehicle_year is defined ? 'open' }}>
          <summary>Cor e ano (opcional)</summary>
          <div class="form-grid">
            {{ ui.input('vehicle_color', 'Cor', v, errors, {max: 30}) }}
            {{ ui.input('vehicle_year', 'Ano', v, errors, {type: 'number', inputmode: 'numeric'}) }}
          </div>
        </details>
      </div>
    </fieldset>

    {% if registered %}
      <div class="form-step">
        {{ ui.input('reason', 'Motivo da retificação', v, errors, {type: 'textarea', max: 300, required: true, help_tip: ajuda.fine_record()}) }}
      </div>
    {% endif %}
    {# A antiga etapa "Revisão" era quase só texto: o aviso ficou junto do botão. #}
    <p class="hint"><strong>Salvar não emite uma autuação oficial</strong> nem consulta Detran ou Senatran.{{ registered ? '' : ' Depois de salvar, a ficha mostra o que ainda falta para registrar.' }}</p>

    <div class="form-actions">
      <a class="btn btn--quiet" href="{{ existing ? url('/multas/' ~ existing.id) : url('/multas') }}">Cancelar</a>
      <button class="btn btn--primary" type="submit">{{ registered ? 'Salvar retificação' : 'Salvar rascunho' }}</button>
    </div>
  </form>
</div>
{% endblock %}
