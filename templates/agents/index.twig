{% extends 'layout.twig' %}
{% import '_ui.twig' as ui %}
{% block title %}Agentes{% endblock %}
{% block content %}
<div class="page">
  <div class="page-head">
    <div>
      <p class="eyebrow">Inventário</p>
      <h1>Agentes</h1>
      <p>{{ total }} agente(s) fictício(s) de trânsito, guarda e polícia. Agente é recurso operacional — não é conta de acesso. A base é o endereço de trabalho; a posição vem das observações.</p>
    </div>
    {% if app.user %}<a class="btn btn--primary" href="{{ url('/agentes/novo') }}">{{ ui.icon('i-plus') }}Novo agente</a>{% endif %}
  </div>
  <form class="toolbar card card--tight" method="get" action="{{ url('/agentes') }}">
    <div class="field"><label for="q">Buscar</label><input id="q" type="search" name="q" value="{{ q }}" placeholder="Indicativo, código, base…" maxlength="60"></div>
    <div class="field"><label for="fn">Função</label>
      <select id="fn" name="categoria[]"><option value="">Todas</option>{% for c in options.categories|filter(c => c.group == 'Agentes') %}<option value="{{ c.value }}" {{ c.value in filters.categories ? 'selected' }}>{{ c.label }}</option>{% endfor %}</select></div>
    <div class="field"><label for="sit">Situação</label>
      <select id="sit" name="situacao[]"><option value="">Todas</option>{% for s in options.statuses|filter(s => s.group == 'Agentes') %}<option value="{{ s.value }}" {{ s.value in filters.statuses ? 'selected' }}>{{ s.label }}</option>{% endfor %}</select></div>
    <div class="field"><label for="org">Órgão</label>
      <select id="org" name="orgao[]"><option value="">Todos</option>{% for a in options.agencies %}<option value="{{ a.id }}" {{ a.id in filters.agencies ? 'selected' }}>{{ a.name }}</option>{% endfor %}</select></div>
    <div class="field"><label for="ord">Ordenar</label>
      <select id="ord" name="ordem">{% for k, l in {codigo: 'Código', nome: 'Indicativo', funcao: 'Função', situacao: 'Situação', bairro: 'Bairro da base'} %}<option value="{{ k }}" {{ sort == k ? 'selected' }}>{{ l }}</option>{% endfor %}</select></div>
    <label class="checks"><span><input type="checkbox" name="arquivados" value="1" {{ archived ? 'checked' }}> Arquivados</span></label>
    <button class="btn" type="submit">Filtrar</button>
  </form>
  {% if rows is empty %}
    <div class="empty">Nenhum agente encontrado. <a href="{{ url('/agentes') }}">Limpar filtros</a></div>
  {% else %}
  <div class="table-wrap">
    <table class="data">
      <caption>Agentes — página {{ page }} de {{ pages }}</caption>
      <thead><tr><th scope="col">Agente</th><th scope="col">Órgão</th><th scope="col">Situação</th><th scope="col">Base</th><th scope="col">Posição</th></tr></thead>
      <tbody>
      {% for a in rows %}
        <tr>
          <td><div class="type-cell"><span class="res__icon res__icon--agent">{{ ui.icon('i-AG_' ~ a.role) }}</span><span><a href="{{ url('/agentes/' ~ a.id) }}"><strong>{{ a.call_sign }}</strong></a><br><span class="small muted mono">{{ a.code }}</span></span></div></td>
          <td class="small">{{ a.agency_name }}</td>
          <td>{{ ui.agent_status(a.status) }}</td>
          <td>{{ a.base_name }}<br><span class="small muted">{{ a.region_name ?? 'sem bairro' }}</span></td>
          <td>{{ ui.status(a.freshness.value, a.freshness.label) }}<br><span class="small faint">{{ a.pos_observed_at|local_dt('d/m H:i') }}</span></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {{ ui.pagination(page, pages, filters.toArray|merge({q: q, ordem: sort, arquivados: archived ? '1' : null}), '/agentes') }}
  {% endif %}
</div>
{% endblock %}
