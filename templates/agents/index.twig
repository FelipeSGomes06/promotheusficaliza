{% extends 'layout.twig' %}
{% import '_ui.twig' as ui %}
{% import '_ajuda.twig' as ajuda %}
{% block title %}Agentes{% endblock %}
{% block content %}
{% set moreActive = (filters.agencies|length > 0 ? 1 : 0) + (archived ? 1 : 0) + (sort != 'codigo' ? 1 : 0) %}
{% set roles = {TRANSITO: 'Agente de trânsito', GUARDA: 'Guarda municipal', POLICIA: 'Policial'} %}
<div class="page">
  <div class="page-head">
    <div>
      <h1>Agentes</h1>
      <p class="lead">Equipes de trânsito, guarda e polícia. A <strong>base</strong> é onde o agente trabalha; a <strong>última posição</strong> é a recebida pelo rádio simulado.</p>
    </div>
    {% if app.user %}<a class="btn btn--primary" href="{{ url('/agentes/novo') }}">{{ ui.icon('i-plus', null, 'icon icon--pop') }}<span>Cadastrar agente</span></a>{% endif %}
  </div>

  <form class="stack section" method="get" action="{{ url('/agentes') }}" role="search" aria-label="Filtrar agentes">
    <div class="filters">
      <div class="field field--search"><label for="q">Buscar</label><input id="q" type="search" name="q" value="{{ q }}" placeholder="Nome, código ou base" maxlength="60"></div>
      <div class="field"><div class="field__head"><label for="fn">Função</label>{{ ui.help('fn-tip', 'Função', ajuda.agent_role()) }}</div>
        <select id="fn" name="categoria[]" aria-describedby="fn-tip"><option value="">Todas as funções</option>{% for c in options.categories|filter(c => c.group == 'Agentes') %}<option value="{{ c.value }}" {{ c.value in filters.categories ? 'selected' }}>{{ c.label }}</option>{% endfor %}</select></div>
      <div class="field"><div class="field__head"><label for="sit">Situação</label>{{ ui.help('sit-tip', 'Situação', ajuda.agent_status()) }}</div>
        <select id="sit" name="situacao[]" aria-describedby="sit-tip"><option value="">Todas as situações</option>{% for s in options.statuses|filter(s => s.group == 'Agentes') %}<option value="{{ s.value }}" {{ s.value in filters.statuses ? 'selected' }}>{{ s.label }}</option>{% endfor %}</select></div>
    </div>
    <div class="filter-bar">
      <button class="btn btn--primary" type="submit">{{ ui.icon('i-filter') }}<span>Filtrar</span></button>
      <details class="more-filters more-filters--inline" {{ moreActive > 0 ? 'open' }}>
        <summary class="chip">{{ ui.icon('i-layers') }}<span>Mais filtros</span> {% if moreActive %}<span class="count-pill">{{ moreActive }}</span>{% endif %}</summary>
        <div class="more-filters__body">
          <div class="field"><label for="org">Órgão</label>
            <select id="org" name="orgao[]"><option value="">Todos os órgãos</option>{% for a in options.agencies %}<option value="{{ a.id }}" {{ a.id in filters.agencies ? 'selected' }}>{{ a.name }}</option>{% endfor %}</select></div>
          <div class="field"><label for="ord">Ordenar por</label>
            <select id="ord" name="ordem">{% for k, l in {codigo: 'Código', nome: 'Nome', funcao: 'Função', situacao: 'Situação', bairro: 'Bairro da base'} %}<option value="{{ k }}" {{ sort == k ? 'selected' }}>{{ l }}</option>{% endfor %}</select></div>
          <div class="checks"><label><input type="checkbox" name="arquivados" value="1" {{ archived ? 'checked' }}> Mostrar só arquivados</label></div>
        </div>
      </details>
      <p class="result-count"><strong>{{ total }}</strong> {{ total == 1 ? 'agente' : 'agentes' }}{{ filters.isEmpty and q == '' ? '' : ' no filtro' }}
        {% if not (filters.isEmpty and q == '' and not archived and sort == 'codigo') %}<a class="btn btn--quiet btn--small" href="{{ url('/agentes') }}"><span>Limpar filtros</span></a>{% endif %}</p>
    </div>
  </form>

  <div class="section">
  {% if rows is empty %}
    <div class="empty">Nenhum agente encontrado com estes filtros. <a href="{{ url('/agentes') }}">Limpar filtros</a></div>
  {% else %}
    <ul class="rows" aria-label="Agentes, página {{ page }} de {{ pages }}">
      {% for a in rows %}
        <li><a class="row" href="{{ url('/agentes/' ~ a.id) }}">
          <span class="row__thumb row__thumb--agent">{{ ui.icon('i-AG_' ~ a.role) }}</span>
          <span class="row__main">
            <span class="row__title">{{ roles[a.role] ?? a.role }} · {{ a.call_sign }}</span>
            <span class="row__sub"><span class="code-tag">{{ a.code }}</span> Base: {{ a.base_name }}{{ a.region_name ? ' · ' ~ a.region_name }}</span>
          </span>
          <span class="row__meta">{{ ui.agent_status(a.status) }}
            {% if a.freshness.value == 'ATUAL' %}<span class="fresh">Posição atual</span>{% elseif a.freshness.value == 'ATRASADA' %}<span class="fresh fresh--ATRASADA">Posição atrasada</span>{% elseif a.freshness.value == 'SEM_INFORMACAO' %}<span class="fresh">Sem posição recente (não indica problema)</span>{% else %}<span class="fresh">Fora de turno: posição não se aplica</span>{% endif %}</span>
        </a></li>
      {% endfor %}
    </ul>
    {{ ui.pagination(page, pages, filters.toArray|merge({q: q, ordem: sort, arquivados: archived ? '1' : null}), '/agentes') }}
  {% endif %}
  </div>
</div>
{% endblock %}
