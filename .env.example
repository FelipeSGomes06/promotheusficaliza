# Copie para .env e troque TODOS os valores "troque-...". Nunca versione o .env.

# --- Aplicação ---
# production | development | test
APP_ENV=development
APP_BASE_PATH=/promotheusfiscaliza
# true em HTTPS (produção)
APP_SECURE_COOKIES=false
# porta local do Compose (127.0.0.1)
APP_PORT=8080

# --- Banco: usuário da aplicação (somente SELECT/INSERT/UPDATE/DELETE concedidos pelas migrações) ---
DB_DSN="firebird:dbname=firebird/3050:/var/lib/firebird/data/fiscaliza.fdb;charset=UTF8;dialect=3"
DB_USER=FISCALIZA_APP
DB_PASSWORD=troque-senha-app

# --- Banco: dono do esquema, usado só por "bin/fiscaliza migrate", pela carga de demonstração e pelos testes ---
# A web e o simulador descartam estas credenciais ao carregar a configuração (Config::PRIVILEGED).
# Em publicação, o .env do servidor web não deve contê-las (docs/operacao.md, "Credenciais por processo").
DB_MIGRATION_USER=FISCALIZA_OWNER
DB_MIGRATION_PASSWORD=troque-senha-dono

# --- Banco de testes de integração (apagado e recriado pelos testes) ---
DB_TEST_DSN="firebird:dbname=firebird/3050:/var/lib/firebird/data/fiscaliza_test.fdb;charset=UTF8;dialect=3"

# --- Contêiner Firebird: senha SYSDBA usada pela imagem na criação do banco; nenhum processo da aplicação a usa ---
FIREBIRD_ROOT_PASSWORD=troque-senha-sysdba

# --- Mapa (provedor de tiles configurável; mantenha a atribuição exigida pelo provedor) ---
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILE_ATTRIBUTION="&copy; colaboradores do OpenStreetMap"

# --- Endereço no cadastro de agentes (ADR-0021): https obrigatório; sem chave ---
# O servidor web precisa sair para a internet (HTTPS, porta 443) até estes endereços.
# Rua pelo CEP (só o CEP é enviado). Fora do ar, a tela pede a rua.
CEP_LOOKUP_URL=https://viacep.com.br/ws
# Ponto da base pela rua, para quem não consegue marcar no mapa (só o nome da rua é enviado; no máximo 1 consulta/s).
GEOCODER_URL=https://nominatim.openstreetmap.org

# --- Demonstração ---
# false em produção: impede apagar/recarregar o banco
DEMO_ALLOW_RESET=true
# perfil da carga: compacto (16 equipamentos e 7 agentes) ou completo (48 e 21)
DEMO_PROFILE=compacto
# semente do cenário sintético reproduzível
SIM_SEED=2026
SIM_INTERVAL_SECONDS=5
POLL_INTERVAL_SECONDS=5
