*.fdb
*.fbk
*.gbk
/backups/

# Notas privadas do proprietário (contexto do portal, hospedagem)
/docs/privado/

# Pacote de entrega gerado
/dist/

# Ambiente e caches do treino Python (ml/marilia-setores/TREINAR.cmd); execuções novas ficam em runs/ até decidir versioná-las
/ml/marilia-setores/.venv/
__pycache__/

# Ferramentas locais de desenvolvimento (não fazem parte do projeto)
/.claude/
/.playwright-mcp/
