#!/usr/bin/env php
<?php

declare(strict_types=1);

// Ponto de entrada da linha de comando (migrações, carga de demonstração, contas, simulador e análise).
// Nada daqui é acessível por HTTP.

if (PHP_SAPI !== 'cli') {
    exit(1);
}

require dirname(__DIR__) . '/vendor/autoload.php';

$args = array_slice($_SERVER['argv'] ?? [], 1);
$config = Fiscaliza\Config::load(dirname(__DIR__));
// Só migração e carga da demonstração usam a identidade de dono; simulador, contas e análise rodam sem essas credenciais.
if (!in_array($args[0] ?? '', ['migrate', 'demo:seed', 'demo:seed-multas'], true)) {
    $config = $config->without(Fiscaliza\Config::PRIVILEGED);
}
$services = new Fiscaliza\Services($config, dirname(__DIR__));
exit((new Fiscaliza\Cli\Console($services))->run($args));
