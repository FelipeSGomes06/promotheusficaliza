{
    "name": "devfelipegomes/promotheus-fiscaliza",
    "description": "Central de fiscalização urbana de Marília/SP (demonstração com dados sintéticos) — DSIN Coder Challenge 2026, etapa F.O.G.O.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_firebird": "*",
        "ext-zip": "*",
        "ext-mbstring": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.88"
    },
    "autoload": {
        "psr-4": { "Fiscaliza\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Fiscaliza\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "check": ["@style", "@stan", "@test"]
    }
}
